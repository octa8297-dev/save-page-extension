{
  "manifest_version": 3,
  "name": "Полное копирование страницы",
  "version": "7.23",
  "description": "Сохраняет длинную страницу целиком — с прокруткой до конца — в Markdown, Word, HTML, TXT или PDF, вместе с картинками.",
  "author": "AldynK",
  "homepage_url": "https://github.com/octa8297-dev/save-page-extension",
  "minimum_chrome_version": "102",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Полное копирование страницы",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
